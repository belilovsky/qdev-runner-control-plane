# Copy only the matching block to /etc/qdev-runner/workers/<lane>.env.
# Shared credentials and image references remain only in /etc/qdev-runner/worker.env.
# A lane is enabled explicitly with: systemctl enable qdev-runner-worker@<lane>.service

# light: qdev-ci, two slots; host needs 4 vCPU, 16 GiB RAM and 120 GiB disk.
QDEV_WORKER_NAME=HOST-light-primary
QDEV_WORKER_TIER=primary
QDEV_WORKER_PROFILES=qdev-ci
QDEV_WORKER_CONCURRENCY=2
QDEV_BUILDKIT_ROOT=/var/lib/qdev-runner-worker/lanes/light/jobs
QDEV_WORKER_MIN_FREE_GIB=20
QDEV_WORKER_MIN_MEMORY_AVAILABLE_GIB=6
QDEV_WORKER_MAX_LOAD_PER_CPU=1.5
QDEV_WORKER_MAX_CPU_PSI_AVG10=15

# browser: qdev-ci-browser, one slot; host needs 4 vCPU, 16 GiB RAM and 120 GiB disk.
# QDEV_WORKER_NAME=HOST-browser-primary
# QDEV_WORKER_TIER=primary
# QDEV_WORKER_PROFILES=qdev-ci-browser
# QDEV_WORKER_CONCURRENCY=1
# QDEV_BUILDKIT_ROOT=/var/lib/qdev-runner-worker/lanes/browser/jobs
# QDEV_WORKER_MIN_FREE_GIB=20
# QDEV_WORKER_MIN_MEMORY_AVAILABLE_GIB=6
# QDEV_WORKER_MAX_LOAD_PER_CPU=1.5
# QDEV_WORKER_MAX_CPU_PSI_AVG10=15

# docker: qdev-ci-compose,qdev-ci-docker, one exclusive slot.  Compose is
# deliberately co-located with Docker because both use the isolated sidecar.
# Its host needs 4 vCPU, 16 GiB RAM and 160 GiB disk, with no other CI lane.
# QDEV_WORKER_NAME=HOST-docker-primary
# QDEV_WORKER_TIER=primary
# QDEV_WORKER_PROFILES=qdev-ci-compose,qdev-ci-docker
# QDEV_WORKER_CONCURRENCY=1
# QDEV_BUILDKIT_ROOT=/var/lib/qdev-runner-worker/lanes/docker/jobs
# QDEV_WORKER_MIN_FREE_GIB=20
# QDEV_WORKER_MIN_MEMORY_AVAILABLE_GIB=10
# QDEV_WORKER_MAX_LOAD_PER_CPU=1.0
# QDEV_WORKER_MAX_CPU_PSI_AVG10=10
