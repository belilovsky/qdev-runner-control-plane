ci.qdev.run {
  encode zstd gzip

  @public_health path /health
  handle @public_health {
    reverse_proxy qdev-runner-broker-public:9020
  }

  @github_webhook path /github/workflow-job
  handle @github_webhook {
    request_body {
      max_size 2MB
    }
    reverse_proxy qdev-runner-broker-public:9020
  }

  # GitHub-hosted recovery may submit only these typed, OIDC-verified
  # bootstrap intents.  The broker independently validates the workflow
  # identity and policy-shaped request before it can create a host dispatch.
  @fleet_bootstrap_ingress {
    method POST
    path /internal/v1/ingress/fleet-bootstrap/activate-controller /internal/v1/ingress/fleet-bootstrap/enrol-host-agent
  }
  handle @fleet_bootstrap_ingress {
    request_body {
      max_size 128KB
    }
    reverse_proxy qdev-runner-broker-internal:9443
  }

  @artifact path /artifacts/*
  handle @artifact {
    request_body {
      max_size 250MB
    }
    reverse_proxy qdev-runner-broker-public:9020
  }

  respond 404
}

registry.ci.qdev.run {
  encode zstd gzip
  basic_auth {
    qdev {$QDEV_REGISTRY_PASSWORD_HASH}
    qdev-runner {$QDEV_RUNNER_REGISTRY_PASSWORD_HASH}
  }
  reverse_proxy qdev-runner-registry:5000
}
