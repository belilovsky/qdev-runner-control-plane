[Unit]
Description=QDev root-owned fleet bootstrap dispatch
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/python3 -I /usr/local/libexec/qdev-fleet-host-dispatch
TimeoutStartSec=35min
UMask=0027
Environment=PYTHONNOUSERSITE=1
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/opt/qdev-runner-control-plane/releases
ReadWritePaths=/opt/qdev-runner-control-plane /var/lib/qdev-runner /etc/qdev-runner /etc/systemd/system /usr/local/libexec /usr/local/sbin /run/lock /run/docker.sock
LockPersonality=true
RestrictSUIDSGID=true
