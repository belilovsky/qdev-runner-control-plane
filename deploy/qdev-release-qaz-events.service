[Unit]
Description=QDev controller-managed Qaz.Events immutable release agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/qdev-runner-control-plane/current/scripts/qdev_product_release_host_agent.py --profile qaz-events --config /etc/qdev-release-agents/qaz-events.env --once
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/qdev-release-agents /run /var/run/docker.sock
