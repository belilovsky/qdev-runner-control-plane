[Unit]
Description=QDev GitHub Actions runner broker
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
WorkingDirectory=/opt/qdev-runner-control-plane
ExecStart=/usr/bin/docker compose -f deploy/compose.yml up -d --build
ExecStop=/usr/bin/docker compose -f deploy/compose.yml down
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target

