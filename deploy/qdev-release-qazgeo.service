[Unit]
Description=QDev controller-managed QGeo immutable release agent
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/qdev-runner-control-plane/current/scripts/qdev_product_release_host_agent.py --profile qazgeo --config /etc/qdev-release-agents/qazgeo.env --once
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/qdev-release-agents /run /var/run/docker.sock /opt/qazgeo/releases/controller
