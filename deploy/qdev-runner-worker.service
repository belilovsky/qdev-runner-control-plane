[Unit]
Description=QDev ephemeral Actions runner worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=qdev-runner
Group=qdev-runner
EnvironmentFile=/etc/qdev-runner/worker.env
Environment=DOCKER_HOST=unix:///run/user/9021/docker.sock
ExecStart=/opt/qdev-runner-worker/.venv/bin/qdev-runner-worker
Restart=always
RestartSec=5
# newuidmap is required to give each BuildKit process its own subordinate UID map.
# The worker itself has no root privileges and only owns its assigned subuid range.
NoNewPrivileges=false
PrivateTmp=true
# The worker must reach the rootless Docker socket under /run/user/9021.
# Jobs run in disposable containers and do not receive the host home directory.
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/qdev-runner-worker
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
