FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
ARG QDEV_SOURCE_REVISION=unknown
ARG QDEV_POLICY_BUNDLE_DIGEST=unknown
LABEL org.opencontainers.image.revision="${QDEV_SOURCE_REVISION}" \
      run.qdev.controller.policy-bundle-digest="${QDEV_POLICY_BUNDLE_DIGEST}"
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN groupadd --system --gid 9020 qdev-runner \
    && useradd --system --uid 9020 --gid 9020 --home /nonexistent \
        --shell /usr/sbin/nologin qdev-runner
WORKDIR /app
COPY pyproject.toml requirements.runtime.txt README.md ./
COPY src ./src
RUN pip install --no-cache-dir -r requirements.runtime.txt && pip install --no-deps .
USER 9020:9020
ENTRYPOINT ["qdev-runner-broker"]
