{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema", "receipt_id", "payload", "digest", "enforcement", "signature"],
  "properties": {
    "schema": {"const": "qdev-controller-receipt-v2"},
    "receipt_id": {"$ref": "#/$defs/digest"}, "digest": {"$ref": "#/$defs/digest"},
    "enforcement": {"const": "enforced"}, "signature": {"$ref": "#/$defs/digest"},
    "payload": {"oneOf": [
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "controller_release"], "properties": {"kind": {"const": "controller-release-audit"}, "observed_at": {"$ref": "#/$defs/time"}, "controller_release": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "workers", "pending"], "properties": {"kind": {"const": "worker-audit"}, "observed_at": {"$ref": "#/$defs/time"}, "workers": {"type": "array", "maxItems": 512, "items": {"type": "object"}}, "pending": {"type": "integer", "minimum": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "operator_session", "mtls_identity", "idempotent", "claim_scope", "immutable_tuple", "managed_registry_entry", "admin_platform_ledger_entry", "worker"], "properties": {"kind": {"const": "fifo-claim-scope-issued"}, "operator_session": {"const": "verified"}, "mtls_identity": {"type": "string", "minLength": 1, "maxLength": 256}, "idempotent": {"const": true}, "claim_scope": {"type": "object"}, "immutable_tuple": {"type": "object"}, "managed_registry_entry": {"type": ["string", "null"]}, "admin_platform_ledger_entry": {"type": ["string", "null"]}, "worker": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "operator_session", "mtls_identity", "idempotent", "replaced_expired_scope", "claim_scope", "immutable_tuple", "managed_registry_entry", "admin_platform_ledger_entry", "worker"], "properties": {"kind": {"const": "fifo-claim-scope-issued"}, "operator_session": {"const": "verified"}, "mtls_identity": {"type": "string", "minLength": 1, "maxLength": 256}, "idempotent": {"const": false}, "replaced_expired_scope": {"type": "boolean"}, "claim_scope": {"type": "object"}, "immutable_tuple": {"type": "object"}, "managed_registry_entry": {"type": ["string", "null"]}, "admin_platform_ledger_entry": {"type": ["string", "null"]}, "worker": {"type": "object"}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "worker_audit", "operation", "required_free_gib"], "properties": {"kind": {"const": "capacity-override-created"}, "observed_at": {"$ref": "#/$defs/time"}, "worker_audit": {"type": "object"}, "operation": {"type": "object"}, "required_free_gib": {"type": "number", "minimum": 0}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "worker_audit", "operation"], "properties": {"kind": {"const": "capacity-override-cancelled"}, "observed_at": {"$ref": "#/$defs/time"}, "worker_audit": {"type": "object"}, "operation": {"type": ["object", "null"]}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "worker_timeout_seconds", "provider_reconciliation_required", "candidates"], "properties": {"kind": {"const": "stale-job-audit"}, "observed_at": {"$ref": "#/$defs/time"}, "worker_timeout_seconds": {"type": "integer", "minimum": 300, "maximum": 3600}, "provider_reconciliation_required": {"const": true}, "candidates": {"type": "array", "maxItems": 512, "items": {"type": "object"}}}},
      {"type": "object", "additionalProperties": false, "required": ["kind", "observed_at", "owner", "reason", "immutable_job", "provider", "action", "fifo_preserved"], "properties": {"kind": {"const": "stale-job-recovery"}, "observed_at": {"$ref": "#/$defs/time"}, "owner": {"type": "string", "minLength": 1, "maxLength": 200}, "reason": {"type": "string", "minLength": 1, "maxLength": 1000}, "immutable_job": {"type": "object"}, "provider": {"type": "object"}, "action": {"type": "string", "minLength": 1, "maxLength": 128}, "fifo_preserved": {"const": true}}}
    ]}
  }, "$defs": {"digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "maxLength": 64}}
}
